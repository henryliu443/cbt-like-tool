CREATE TABLE HistoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    inputText TEXT NOT NULL,
    aiResponse TEXT,
    timestamp INTEGER NOT NULL
);

insertHistory:
INSERT OR REPLACE INTO HistoryEntity(id, inputText, aiResponse, timestamp)
VALUES (?, ?, ?, ?);

selectAllHistory:
SELECT * FROM HistoryEntity ORDER BY timestamp DESC;

deleteHistoryById:
DELETE FROM HistoryEntity WHERE id = ?;

deleteAllHistory:
DELETE FROM HistoryEntity;

CREATE TABLE MoodCheckInEntity (
    id TEXT NOT NULL PRIMARY KEY,
    emotion TEXT,
    intensity INTEGER,
    timestamp INTEGER NOT NULL
);

insertMoodCheckIn:
INSERT OR REPLACE INTO MoodCheckInEntity(id, emotion, intensity, timestamp)
VALUES (?, ?, ?, ?);

selectAllMoodCheckIns:
SELECT * FROM MoodCheckInEntity ORDER BY timestamp DESC;

getMoodInsightsGroupedByDate:
SELECT 
    strftime('%Y-%m-%d', timestamp / 1000, 'unixepoch', :offsetModifier) AS dateLabel,
    AVG(intensity) AS avgIntensity,
    COUNT(id) AS reframeFrequency
FROM MoodCheckInEntity
WHERE timestamp >= :sinceTimestamp
GROUP BY dateLabel
ORDER BY dateLabel ASC;
